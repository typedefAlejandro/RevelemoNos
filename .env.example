# Copie para .env.local e preencha (Supabase > Project Settings > API Keys).
# NEXT_PUBLIC_* vai para o navegador: só coloque aqui o que pode ser público.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Domínio de e-mail aceito no login (o bloqueio real é no banco, Fase 1).
ALLOWED_EMAIL_DOMAIN=unifei.edu.br

# Opcional: token do GitHub SEM permissões (fine-grained, "Public repositories"),
# só para subir o limite da API pública de 60 para 5000 req/h.
# GITHUB_TOKEN=

# NUNCA prefixe a chave secreta com NEXT_PUBLIC_ e nunca a commite.
# Só adicione quando uma funcionalidade realmente precisar.
# SUPABASE_SECRET_KEY=
